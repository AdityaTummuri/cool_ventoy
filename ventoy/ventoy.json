{
    "theme": {
        "file": "/ventoy/theme/multiboot-toolkit/theme.txt",
        "gfxmode": "1920x1080",
        "display_mode": "GUI",
        "ventoy_left": "5%",
        "ventoy_top": "95%",
        "ventoy_color": "#2a9d8f"
    },

    "control": [
        { "VTOY_DEFAULT_MENU_MODE": "1" },
        { "VTOY_TREE_VIEW_MENU_STYLE": "1" },
        { "VTOY_DEFAULT_SEARCH_ROOT": "/" },
        { "VTOY_WIN11_BYPASS_CHECK": "1" },
        { "VTOY_WIN11_BYPASS_NRO": "1" },
        { "VTOY_FILT_DOT_UNDERSCORE_FILE": "1" },
        { "VTOY_SORT_CASE_SENSITIVE": "0" }
    ],

    "menu_alias": [
        { "dir": "/OS",          "alias": "Operating Systems" },
        { "dir": "/Gaming",      "alias": "Gaming" },
        { "dir": "/Security",    "alias": "Security & Privacy" },
        { "dir": "/Recovery",    "alias": "Recovery & Repair" },
        { "dir": "/Diagnostics", "alias": "Diagnostics" }
    ],

    "menu_class": [
        { "dir": "/OS",          "class": "os" },
        { "dir": "/Gaming",      "class": "gaming" },
        { "dir": "/Security",    "class": "security" },
        { "dir": "/Recovery",    "class": "recovery" },
        { "dir": "/Diagnostics", "class": "diagnostics" },

        { "key": "Win11",         "class": "windows" },
        { "key": "Win_11",        "class": "windows" },
        { "key": "windows",       "class": "windows" },
        { "key": "ubuntu",        "class": "ubuntu" },
        { "key": "debian",        "class": "debian" },
        { "key": "linuxmint",     "class": "mint" },
        { "key": "mint",          "class": "mint" },
        { "key": "pop-os",        "class": "popos" },
        { "key": "pop_os",        "class": "popos" },
        { "key": "bazzite",       "class": "bazzite" },
        { "key": "pikaos",        "class": "pikaos" },
        { "key": "pika",          "class": "pikaos" },
        { "key": "nobara",        "class": "nobara" },
        { "key": "kali",          "class": "kali" },
        { "key": "tails",         "class": "tails" },
        { "key": "systemrescue",  "class": "systemrescue" },
        { "key": "gparted",       "class": "gparted" },
        { "key": "clonezilla",    "class": "clonezilla" },
        { "key": "rescuezilla",   "class": "rescuezilla" },
        { "key": "Hirens",        "class": "hirens" },
        { "key": "HBCD",          "class": "hirens" },
        { "key": "memtest",       "class": "memtest" }
    ]
}
